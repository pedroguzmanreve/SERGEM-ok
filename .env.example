# ==============================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN VERCEL Y PRODUCCIÓN
# SERGEM MENSAJERÍA S.A.S. - Sistema de Nómina y Turnos
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Firebase Web (Obtén estos valores en Firebase Console:
#    Configuración del Proyecto -> General -> Tus apps -> SDK setup and configuration)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Base de Datos Firestore (Si usas una base de datos nombrada o '(default)')
# ------------------------------------------------------------------------------
VITE_FIREBASE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 3. Servicios del Sistema (Opcionales para Vercel / APIs)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
APP_URL=
