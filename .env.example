# APP_URL: URL base pública donde se aloja el aplicativo (Vercel, Netlify, Cloud Run)
# Usada para redirecciones de autenticación, enlaces absolutos y webhooks.
APP_URL="https://app.sergem.com.co"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (POSTGRESQL, AUTH, STORAGE & REALTIME)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (Dashboard -> Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave pública anónima de Supabase (Dashboard -> Settings -> API -> Project API Keys -> anon / public)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# (Opcional - solo CI/CD o Backend) Service Role Key para migraciones y scripts administrativos
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# TESTING & CI/CD CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL para pruebas E2E con Playwright (por defecto http://localhost:3000)
PLAYWRIGHT_TEST_BASE_URL="http://localhost:3000"
